include "shaders_dx11.blk"
"@delete-all:packBin":b=false; packBin:b=yes

"@override:source"
{
  file:t = "depth_hierarchy.dshl"
  file:t = "testgi_bvh_debug.dshl"
  file:t = "testgi_rtsm.dshl"
  file:t = "../../../../prog/gameLibs/bvh/shaders/bvh_process_dynrend_indices.dshl"
  file:t = "../../../../prog/gameLibs/bvh/shaders/bvh_process_bake_texture_to_vertices.dshl"
  file:t = "../../../../prog/gameLibs/bvh/shaders/bvh_process_ahs_vertices.dshl"
  file:t = "../../../../prog/gameLibs/bvh/shaders/bvh_process_tree_vertices.dshl"
  file:t = "../../../../prog/gameLibs/render/denoiser/shaders/denoiser_prepare.dshl"
}

"@override:outDumpName":t="../../game/compiledShaders/gameDX12"
"@override:Compile" {
  "@override:fsh":t="5.0"
  "@override:assume_vars" {
    "@delete:dagi_warp64_irradiance":i=0
     gi_voxelize_use_multidraw:i=1
     // the sample never denoises with NRD checkerboard depth; pinning the
     // interval skips compiling that variant (broken upstream in the RTR
     // half-res motion store), which the sample build would otherwise hit
     rtr_depth_mode:i=0
	hardware_raytracing:i=0     // Exclude hardware raytracing variants
     rtsm_enabled:i=0            // Exclude ray-traced shadow map variants
     vrs_enabled:i=0             // Exclude SV_ShadingRate to keep target SM at 6.0/6.2
  }
}


incDir:t="../../../../prog/gameLibs/bvh/shaders"
